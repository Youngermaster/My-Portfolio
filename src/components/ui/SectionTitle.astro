---
/**
 * Eyebrow + heading pair. Words wrapped in the `highlight` prop are rendered
 * red, matching the original's `<span>` treatment inside headings.
 */
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow?: string;
  title: string;
  /** Substrings of `title` to render in red. Matched case-sensitively. */
  highlight?: string[];
  align?: 'left' | 'center';
  as?: 'h1' | 'h2';
  onDark?: boolean;
  class?: string;
}

const {
  eyebrow,
  title,
  highlight = [],
  align = 'left',
  as: Heading = 'h2',
  onDark = false,
  class: className,
}: Props = Astro.props;

/**
 * Split the title into plain and highlighted runs. Doing this here rather than
 * asking callers to hand-write markup keeps the content translatable as a
 * single string.
 */
function splitHighlights(text: string, terms: string[]) {
  if (terms.length === 0) return [{ text, highlighted: false }];

  const escaped = terms
    .filter(Boolean)
    .map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'))
    .sort((a, b) => b.length - a.length);

  if (escaped.length === 0) return [{ text, highlighted: false }];

  const pattern = new RegExp(`(${escaped.join('|')})`, 'g');
  return text
    .split(pattern)
    .filter((part) => part !== '')
    .map((part) => ({ text: part, highlighted: terms.includes(part) }));
}

const parts = splitHighlights(title, highlight);
---

<div class:list={['section-title', align, className]}>
  {eyebrow && <Eyebrow onDark={onDark}>{eyebrow}</Eyebrow>}
  <Heading class="title">
    {parts.map((part) => (part.highlighted ? <span>{part.text}</span> : part.text))}
  </Heading>
  <slot />
</div>

<style>
  .center {
    margin-inline: auto;
    max-width: 760px;
    text-align: center;
  }

  /* No `text-transform: capitalize` here, unlike the original: it forces title
     case onto Spanish, where "Sobre mí" is correct and "Sobre Mí" is not.
     Casing belongs to the copy, which is already written per language. */
  .title {
    font-size: 64px;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 100.8%;
  }

  .title span {
    color: var(--color-red);
  }

  @media (max-width: 1400px) {
    .title {
      font-size: 60px;
    }
  }

  @media (max-width: 1199px) {
    .title {
      font-size: 50px;
    }
  }

  @media (max-width: 991px) {
    .title {
      font-size: 40px;
    }
  }

  @media (max-width: 767px) {
    .title {
      font-size: 30px;
    }
  }
</style>
