---
/**
 * The framed eyebrow badge.
 *
 * A red 39x39 square outline sits *behind* the label, and a white knockout
 * square erases the part of the frame the text runs through — so the frame
 * reads as an open bracket the words are stepping out of. Two pseudo-elements,
 * no images.
 */
interface Props {
  class?: string;
  /** Rendered on a dark surface: the knockout square must match the surface. */
  onDark?: boolean;
}

const { class: className, onDark = false } = Astro.props;
---

<span class:list={['eyebrow', { 'on-dark': onDark }, className]}>
  <slot />
</span>

<style>
  .eyebrow {
    background: var(--color-paper);
    color: var(--color-red-ink);
    display: inline-block;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 26px;
    margin-bottom: 25px;
    padding-left: 15px;
    position: relative;
    z-index: 1;
  }

  /* The frame */
  .eyebrow::before {
    border: 2px solid var(--color-red);
    content: '';
    height: 39px;
    left: 0;
    position: absolute;
    top: -8px;
    width: 39px;
    z-index: -2;
  }

  /* The knockout that opens the frame up */
  .eyebrow::after {
    background: var(--color-paper);
    content: '';
    height: 20px;
    left: 34px;
    position: absolute;
    top: 2px;
    width: 20px;
    z-index: -1;
  }

  .on-dark,
  .on-dark::after {
    background: var(--color-invert);
  }

  @media (max-width: 575px) {
    .eyebrow {
      font-size: 16px;
      margin-bottom: 20px;
    }
  }
</style>
