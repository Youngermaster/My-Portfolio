{
  "name": "jmyounghoyos-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build && node scripts/prune-unused-assets.mjs",
    "build:fast": "astro build && node scripts/prune-unused-assets.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write \"**/*.{astro,ts,js,css,md,json,yaml}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,js,css,md,json,yaml}\"",
    "astro": "astro",
    "og": "node scripts/make-og-images.mjs",
    "optimize:panels": "node scripts/optimize-panels.mjs",
    "images:check": "node scripts/scrub-image-metadata.mjs --check",
    "images:scrub": "node scripts/scrub-image-metadata.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^7.2.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}